<?xml version="1.0"?>
<package format="3">
  <name>drive_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes around drive/: a simulated car, the control loop, a recorder and a teleop window.</description>
  <maintainer email="ninhnn2@users.noreply.github.com">ninhnn2</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
