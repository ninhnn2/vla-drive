&gt;(training report)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="155" height="90" as="geometry"/></mxCell><mxCell id="c43" value="smolvla-local venv · Python 3.12 · LeRobot 0.5.2 · torch 2.11" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=12;fillColor=#fffbea;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1055" y="440" width="410" height="590" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;python -m drive export&lt;/b&gt;&lt;br&gt;action = plans[i, 0]: the teacher's intent,&lt;br&gt;not the disturbed steering" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1070" y="485" width="380" height="70" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;runs/drive/lerobot&lt;/b&gt; · LeRobotDataset v3.0&lt;br&gt;AV1 video + Parquet + stats.json&lt;br&gt;82 episodes · 24 876 frames · 35 MB" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1070" y="580" width="380" height="85" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;lerobot-train&lt;/b&gt; --policy.path=lerobot/smolvla_base&lt;br&gt;--rename_map front → camera1&lt;br&gt;chunk 16 × 0.1 s · batch 16 · 2000 steps&lt;br&gt;&lt;b&gt;fine-tune&lt;/b&gt;: VLM frozen (350 M), action expert trained (100 M)&lt;br&gt;13 min · RTX 4060 Laptop 8 GB" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="380" height="115" as="geometry"/></mxCell><mxCell id="c47" v