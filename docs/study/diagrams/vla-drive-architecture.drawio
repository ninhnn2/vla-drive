width="220" height="70" as="geometry"/></mxCell><mxCell id="c12" value="SmolVLM2 tokenizer&lt;br&gt;max 48 tokens" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="335" width="220" height="60" as="geometry"/></mxCell><mxCell id="c13" value="normalise with the dataset's&lt;br&gt;mean / std · pad to 32" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="470" width="220" height="60" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c7" target="c11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c8" target="c12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c9" target="c13"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="VLM backbone · SmolVLM2-500M, first 16 layers · frozen (350 M)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#f3f7fd;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="560" height="560" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;vision encoder&lt;/b&gt; (SigLIP)&lt;br&gt;86.4 M" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="230" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;connector&lt;/b&gt; → image tokens&lt;br&gt;11.8 M" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="185" width="240" height="70" as="geometry"/></mxCell><mxCell id="c20" value="token embeddings" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="335" width="230" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;state projection&lt;/b&gt; → 1 token&lt;br&gt;(trained)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="540" y="465" width="230" height="65" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;language model&lt;/b&gt;&lt;br&gt;16 transformer layers&lt;br&gt;251.9 M&lt;br&gt;&lt;br&gt;prefix = image tokens&lt;br&gt;+ text tokens + state token&lt;br&gt;→ keys / values,&lt;br&gt;computed once per inference" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="260" height="200" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c11" target="c18"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c18" target="c19"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c12" target="c20"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c20" target="c22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c13" target="c21"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="c21" target="c22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="action expert · flow matching · trained (98.2 M + 1.6 M projections)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#fff8ef;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="420" height="560" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;x&lt;/b&gt;: noisy chunk 16 × 32&lt;br&gt;starts as pure noise (drawn by BackendPolicy)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="380" height="55" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;action_in_proj&lt;/b&gt;&lt;br&gt;32 → expert width" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1130" y="250" width="230" height="50" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;time t&lt;/b&gt;&lt;br&gt;→ time MLP" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1380" y="250" width="130" height="50" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;expert transformer&lt;/b&gt; · 98.2 M&lt;br&gt;width 0.75 × the VLM's&lt;br&gt;attends to the VLM's keys / values" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="380" height="90" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;action_out_proj&lt;/b&gt; → velocity v, 16 × 32" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1130" y="465" width="380" height="50" as="geometry"/></mxCell><mxCell id="c36" value="&lt;i&gt;run 10 times per chunk: x ← x − 0.1 · v, t from 1 to 0&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;align=center;fontColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="1130" y="540" width="380" height="40" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c32" target="c34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="keys / values" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c22" target="c34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c34" target="c35"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c35" target="c31"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="490"/><mxPoint x="1120" y="187"/></Array></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Inference&lt;/b&gt; (sim --policy vla, every chunk)&lt;br&gt;start at t = 1 with x = noise&lt;br&gt;10 Euler steps x ← x − 0.1 · v(x, t), t → 0&lt;br&gt;the VLM prefix is reused for all 10 steps&lt;br&gt;≈ 125 ms on the RTX 4060 Laptop" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1130" y="700" width="400" height="120" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Fine-tuning&lt;/b&gt; (lerobot-train, 2000 steps)&lt;br&gt;target = the next 16 dataset actions (frames i … i+15)&lt;br&gt;x_t = t · noise + (1 − t) · actions, t ~ Beta(1.5, 1)&lt;br&gt;loss = MSE(v, noise − actions)&lt;br&gt;only the orange parts change" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="700" width="560" height="120" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;post-processor&lt;/b&gt;&lt;br&gt;keep dims 0–1 of 32&lt;br&gt;un-normalise with the dataset's stats" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="470" width="220" height="85" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;chunk&lt;/b&gt; 16 × [steer, throttle]&lt;br&gt;0.1 s apart · 1.5 s ahead" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="590" width="220" height="65" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;BackendPolicy&lt;/b&gt;&lt;br&gt;clip to ±1 · ActionChunk(t_obs)&lt;br&gt;→ ChunkExecutor (page 2)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="690" width="220" height="80" as="geometry"/></mxCell><mxCell id="c48" value="after 10 steps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c35" target="c45"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c45" target="c46"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c46" target="c47"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="For comparison · ChunkNet (the cnn policy) · 0.32 M · trained from scratch · direct regression with Smooth L1 on the teacher's plans" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1080" height="120" as="geometry"/></mxCell><mxCell id="c52" value="image&lt;br&gt;96 × 128" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="120" height="55" as="geometry"/></mxCell><mxCell id="c53" value="5 conv 3×3, stride 2&lt;br&gt;24 · 36 · 48 · 64 · 64" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="190" y="905" width="190" height="55" as="geometry"/></mxCell><mxCell id="c54" value="768 features&lt;br&gt;⊕ [speed / 3, steer]" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="905" width="170" height="55" as="geometry"/></mxCell><mxCell id="c55" value="MLP 256 · 128 · 32" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="905" width="160" height="55" as="geometry"/></mxCell><mxCell id="c56" value="tanh → 16 × [steer, throttle]&lt;br&gt;one pass, no noise" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="905" width="270" height="55" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c52" target="c53"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c53" target="c54"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c54" target="c55"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c55" target="c56"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="4 · Reading the source code"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Reading the source&lt;/b&gt; · to use the model you do not need it; to understand, debug, change or speed it up, you do" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Read the source when&lt;/b&gt;&lt;br&gt;• a result has no explanation (it weaves, stops, drives slow)&lt;br&gt;• you change the data, the chunk length or the camera&lt;br&gt;• you choose what to train and what to freeze&lt;br&gt;• you make it faster, or port it to TensorRT&lt;br&gt;&lt;br&gt;&lt;b&gt;How&lt;/b&gt;: run it → print the shapes of one batch → change one thing → evaluate" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="520" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Where the code is&lt;/b&gt;&lt;br&gt;LeRobot clone: /home/fanning/data1/AI_SOURCE/VLA/lerobot/src/lerobot/&lt;br&gt;installed copy (what runs): smolvla-local/.venv/lib/python3.12/site-packages/lerobot/&lt;br&gt;this repo: vla-drive/drive/&lt;br&gt;both LeRobot copies are version 0.5.2" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="65" width="620" height="150" as="geometry"/></mxCell><mxCell id="c4" value="A · vla-drive: where the model meets the car (read first)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#eef6ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="520" height="830" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;① drive/types.py&lt;/b&gt;&lt;br&gt;Observation, ActionChunk: the contract every policy keeps" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="480" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;② drive/policy/lerobot_backend.py&lt;/b&gt; · LeRobotBackend.infer&lt;br&gt;image → pre-processor → predict_action_chunk → post-processor" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="480" height="70" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c5" target="c6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;③ drive/policy/vla.py&lt;/b&gt; · BackendPolicy&lt;br&gt;draws the noise 1 × 16 × 32, keeps 2 action dims, clips to ±1" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="480" height="70" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c6" target="c8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;④ drive/control/executor.py&lt;/b&gt; · ChunkExecutor&lt;br&gt;which step of the chunk is played now (now − t_obs)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="480" height="70" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c8" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;⑤ drive/safety.py&lt;/b&gt; · SafetySupervisor.filter&lt;br&gt;what actually reaches the motors, and why" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="480" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c10" target="c12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;⑥ drive/learn/export.py&lt;/b&gt; · frames()&lt;br&gt;what the model is taught: action = plans[i, 0]" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="480" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c12" target="c14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;⑦ drive/learn/collect.py&lt;/b&gt; · collect, Disturbance&lt;br&gt;where the data comes from: teacher + steering noise" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="480" height="60" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c14" target="c16"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;⑧ drive/learn/evaluate.py&lt;/b&gt; · evaluate&lt;br&gt;how it is judged: 3 tracks × 2 directions, pass / fail" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="480" height="60" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c16" target="c18"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="B · LeRobot SmolVLA: the model itself · policies/smolvla/ · 1 758 lines in 4 files" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#fff8ef;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="760" height="830" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;① configuration_smolvla.py&lt;/b&gt; (159 lines) · &lt;b&gt;SmolVLAConfig&lt;/b&gt;: every knob&lt;br&gt;chunk_size 50 · n_action_steps 50 · num_steps 10 · max_state_dim / max_action_dim 32 · resize_imgs_with_padding 512&lt;br&gt;freeze_vision_encoder · train_expert_only · train_state_proj · num_vlm_layers 16 · expert_width_multiplier 0.75&lt;br&gt;attention_mode cross_attn · self_attn_every_n_layers 2 · optimizer_lr 1e-4 · warmup 1000 · decay 30 000&lt;br&gt;load_vlm_weights · compile_model · rtc_config" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="285" width="720" height="120" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;② processor_smolvla.py&lt;/b&gt; (103) · make_smolvla_pre_post_processors (L39)&lt;br&gt;pre: rename → batch → newline → tokenizer (48) → device → normalise · post: un-normalise → cpu" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="430" width="720" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;③ modeling_smolvla.py&lt;/b&gt; (916) · &lt;b&gt;SmolVLAPolicy&lt;/b&gt; (L226): the LeRobot-facing wrapper&lt;br&gt;forward (L358): the training loss; keeps the 2 real action dims, masks chunk steps past the episode end (action_is_pad)&lt;br&gt;predict_action_chunk (L313): inference · prepare_images (L415): resize_with_pad, scale to [−1, 1]&lt;br&gt;prepare_state (L484) · prepare_action (L490): pad to 32" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="515" width="720" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;④ modeling_smolvla.py&lt;/b&gt; · &lt;b&gt;VLAFlowMatching&lt;/b&gt; (L541): the network&lt;br&gt;embed_prefix (L637): image tokens + text tokens + 1 state token&lt;br&gt;embed_suffix (L731): noisy actions + time embedding → expert tokens&lt;br&gt;forward (L774): x_t = t·noise + (1 − t)·actions, target u = noise − actions, MSE&lt;br&gt;sample_actions (L812): prefix keys/values once, then 10 Euler steps · denoise_step (L883)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="640" width="720" height="115" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;⑤ smolvlm_with_expert.py&lt;/b&gt; (561) · &lt;b&gt;SmolVLMWithExpertModel&lt;/b&gt; (L72)&lt;br&gt;loads SmolVLM2, keeps its first 16 layers, builds the smaller expert next to them&lt;br&gt;set_requires_grad (L150): what is frozen · forward (L415): VLM and expert layers run side by side,&lt;br&gt;the expert cross-attends to the VLM, self-attention every 2nd layer" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="780" width="720" height="100" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c21" target="c22"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c22" target="c23"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c23" target="c24"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c24" target="c25"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Trace one batch&lt;/b&gt; (B = 16 in the fine-tune)&lt;br&gt;images (B, 3, 240, 320) → resize + pad → (B, 3, 512, 512) → SigLIP + connector → image tokens&lt;br&gt;task → tokenizer → (B, 48) tokens · state (B, 2) → normalise → pad (B, 32) → 1 token&lt;br&gt;actions (B, 16, 2) → normalise → pad (B, 16, 32) → x_t → expert → v (B, 16, 32)&lt;br&gt;loss (B, 16, 32) → keep [..., :2] → mask action_is_pad → mean" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="905" width="720" height="125" as="geometry"/></mxCell><mxCell id="c31" value="C · LeRobot training plumbing" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#f3f7fd;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1340" y="240" width="540" height="830" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;scripts/lerobot_train.py&lt;/b&gt;&lt;br&gt;train (L175): build dataset, policy, processors, optimizer, loop&lt;br&gt;update_policy (L71): forward → backward → clip gradients (10)&lt;br&gt;→ AdamW step → learning-rate schedule" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="285" width="500" height="95" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;policies/factory.py&lt;/b&gt;&lt;br&gt;make_policy (L466) · make_pre_post_processors (L252)&lt;br&gt;get_policy_class (L84): name → class (used by LeRobotBackend)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="405" width="500" height="75" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;datasets/lerobot_dataset.py&lt;/b&gt; · LeRobotDataset&lt;br&gt;delta_timestamps → the 16-step action target of each frame&lt;br&gt;+ action_is_pad past the end of an episode" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="505" width="500" height="75" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;configs/train.py&lt;/b&gt; · TrainPipelineConfig (L77)&lt;br&gt;&lt;b&gt;configs/default.py&lt;/b&gt; · DatasetConfig, PeftConfig&lt;br&gt;every lerobot-train flag is a field path:&lt;br&gt;--policy.chunk_size · --dataset.image_transforms.enable · --peft.r" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="605" width="500" height="95" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Tip&lt;/b&gt;: lerobot-train --help lists every flag.&lt;br&gt;Put a breakpoint (or print shapes) in&lt;br&gt;embed_prefix, VLAFlowMatching.forward and sample_actions&lt;br&gt;and run 2 training steps on 2 episodes." style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="725" width="500" height="90" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c32" target="c33"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c33" target="c34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c34" target="c35"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="5 · Improving the model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Improving the model&lt;/b&gt; · how an AI engineer raises accuracy, and keeps it fast enough to drive" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="80" height="22" as="geometry"/></mxCell><mxCell id="c3" value="available now in vla-drive" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="966" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="a lerobot-train flag (LeRobot 0.5.2)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1002" width="300" height="30" as="geometry"/></mxCell><mxCell id="c5" value="proposed: needs code or hardware" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1038" width="300" height="30" as="geometry"/></mxCell><mxCell id="c6" value="① &lt;b&gt;hypothesis&lt;/b&gt;&lt;br&gt;one change, a predicted effect" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="200" height="65" as="geometry"/></mxCell><mxCell id="c7" value="② &lt;b&gt;change&lt;/b&gt;&lt;br&gt;the data or the recipe" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="175" width="200" height="65" as="geometry"/></mxCell><mxCell id="c8" value="③ &lt;b&gt;fine-tune&lt;/b&gt;&lt;br&gt;same steps · 3 seeds" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="175" width="200" height="65" as="geometry"/></mxCell><mxCell id="c9" value="④ &lt;b&gt;evaluate closed-loop&lt;/b&gt;&lt;br&gt;evaluate · recovery · latency" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="175" width="200" height="65" as="geometry"/></mxCell><mxCell id="c10" value="⑤ &lt;b&gt;error analysis&lt;/b&gt;&lt;br&gt;debug panel · --log · browse" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="175" width="200" height="65" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c6" target="c7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c8" target="c9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="keep it or revert it, then the next hypothesis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c10" target="c6"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="265"/><mxPoint x="120" y="265"/></Array></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• judge by driving (evaluate), not by the training loss&lt;br&gt;• one variable at a time, the rest fixed&lt;br&gt;• the latency of the hardware you will run on&lt;br&gt;• 3 seeds before believing a small difference&lt;br&gt;• keep the baseline's report to compare against" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="85" width="340" height="160" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Baseline today&lt;/b&gt; (6/6 drives each)&lt;br&gt;smolvla-v1 @125 ms: 1.44 m/s · &lt;b&gt;4.8 cm rms&lt;/b&gt; · 15 cm worst&lt;br&gt;CNN v1 @100 ms: 0.84 m/s · 1.3 cm rms&lt;br&gt;teacher: 1.47 m/s · 1.5 cm rms&lt;br&gt;&lt;b&gt;goal&lt;/b&gt;: teacher-like tracking at teacher speed" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1530" y="85" width="350" height="160" as="geometry"/></mxCell><mxCell id="c18" value="A · Data — usually the biggest lever" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#eef6ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="450" height="620" as="geometry"/></mxCell><mxCell id="c19" value="B · Fine-tuning recipe (lerobot-train)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#fffbea;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="300" width="450" height="620" as="geometry"/></mxCell><mxCell id="c20" value="C · Evaluation and error analysis" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#eef6ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="450" height="620" as="geometry"/></mxCell><mxCell id="c21" value="D · Inference and latency" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#f7f7f8;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1430" y="300" width="450" height="620" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;More, and more varied, episodes&lt;/b&gt;&lt;br&gt;collect --episodes · --tracks peanut,oval · a new --seed each time&lt;br&gt;keep one track out of training to test on" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="410" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Recovery data&lt;/b&gt;: --steer-noise 0.1 / 0.25 / 0.5&lt;br&gt;too little: it cannot recover · too much: views it never meets&lt;br&gt;(experiment E5)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="433" width="410" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Chunk-target noise&lt;/b&gt; (measured): beyond 0.5 s the target differs&lt;br&gt;from the clean plan by ≈ 0.2 steer → try less noise, or a shorter&lt;br&gt;--policy.chunk_size (8)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="521" width="410" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;DAgger in the simulator&lt;/b&gt;: the model drives, the teacher labels each&lt;br&gt;frame from where the car really is, add, fine-tune again" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="609" width="410" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Mirror at export&lt;/b&gt;: flip the image, negate the steering&lt;br&gt;doubles the data, removes left/right bias (the CNN does this)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="687" width="410" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Several task sentences&lt;/b&gt; ('drive slowly', 'stop at the cone')&lt;br&gt;with matching driving — only if you want language control" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="410" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Check before training&lt;/b&gt;: ./drive.sh validate · browse&lt;br&gt;a bad label costs a whole fine-tune" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="843" width="410" height="55" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Longer&lt;/b&gt;: --steps 10000–20000&lt;br&gt;2000 steps = 13 min here; LeRobot docs: 20 k ≈ 4 h on one A100" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="345" width="410" height="55" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Batch&lt;/b&gt;: --batch_size 16 fits 8 GB; 64 on a larger GPU (Colab)&lt;br&gt;LeRobot 0.5.2 has no gradient accumulation" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="418" width="410" height="55" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Learning rate&lt;/b&gt;: --policy.optimizer_lr (1e-4)&lt;br&gt;--policy.scheduler_warmup_steps (1000) · scheduler_decay_steps (30 000)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="491" width="410" height="55" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;What trains&lt;/b&gt;: --policy.train_expert_only=false&lt;br&gt;--policy.freeze_vision_encoder=false (more GPU memory, more overfitting)&lt;br&gt;or LoRA adapters: --peft.method_type=LORA --peft.r=16" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="564" width="410" height="75" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Image augmentation&lt;/b&gt;: --dataset.image_transforms.enable=true&lt;br&gt;brightness, contrast, saturation, hue …" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="657" width="410" height="55" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Chunk&lt;/b&gt;: --policy.chunk_size / --policy.n_action_steps (16 now)&lt;br&gt;shorter: less far-end noise; longer: more room for latency" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="730" width="410" height="55" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Watch held-out loss&lt;/b&gt;: --dataset.eval_split=0.1 --eval_steps=500&lt;br&gt;a sanity check only: lower loss is not better driving" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="803" width="410" height="55" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;evaluate&lt;/b&gt; on 3 tracks × 2 directions at the real latency&lt;br&gt;python -m drive evaluate smolvla-v1 --latency-ms 125" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="345" width="410" height="55" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Recovery test&lt;/b&gt;: start 25–35 cm off, 0.3–0.5 rad askew&lt;br&gt;CNN v1 recovered from 25 cm, left the road from 35 cm (E10);&lt;br&gt;not yet measured for smolvla-v1" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="418" width="410" height="70" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Latency sweep&lt;/b&gt;: python -m drive sweep --policy vla&lt;br&gt;--checkpoint smolvla-v1 --latencies 125,200,250,300" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="506" width="410" height="55" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Seeds&lt;/b&gt;: 3 fine-tunes per setting (--seed), report mean ± spread" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="579" width="410" height="45" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Error analysis&lt;/b&gt;: sim --show --log actions.csv&lt;br&gt;debug panel: where does it weave? which chunk steps disagree?&lt;br&gt;CSV: plan age, stale ticks, model vs motors" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="642" width="410" height="70" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Compare like with like&lt;/b&gt;&lt;br&gt;same latency, same speed, same tracks, same duration" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="730" width="410" height="50" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Fewer denoising steps&lt;/b&gt;: num_steps 10 → 5&lt;br&gt;about half the expert's time; measure the accuracy it costs&lt;br&gt;(config.json of the checkpoint)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="345" width="410" height="70" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;torch.compile&lt;/b&gt;: --policy.compile_model=true" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="433" width="410" height="40" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Lower precision and TensorRT&lt;/b&gt; on the Jetson&lt;br&gt;jetson-orin-nano-vla: export.sh → run.sh (SmolVLA ≈ 108 ms)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="491" width="410" height="60" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Real-time chunking&lt;/b&gt;: --policy.rtc_config in LeRobot,&lt;br&gt;for models slower than ≈ 250 ms; not wired into DriveLoop" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="569" width="410" height="60" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Speed versus latency&lt;/b&gt;: the loop fails near v · L ≈ 0.38 m&lt;br&gt;(teacher, simulator) → slower car, or a faster model" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="647" width="410" height="60" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Watchdog&lt;/b&gt;: max plan age must exceed 2 × latency&lt;br&gt;(default 0.6 s → latency below 0.3 s)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="725" width="410" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
