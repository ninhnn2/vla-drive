<mxfile host="drawio" modified="2026-11-17T00:00:00.000Z" agent="vla-drive" version="24.0.0"><diagram id="page0" name="1 · Pipeline: sim → data → fine-tune → drive"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;vla-drive&lt;/b&gt; · from the simulator to a fine-tuned SmolVLA driving the car" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="4" width="80" height="22" as="geometry"/></mxCell><mxCell id="c3" value="implemented · Docker container / host (./drive.sh, make)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="implemented · smolvla-local venv (LeRobot)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1560" y="66" width="300" height="30" as="geometry"/></mxCell><mxCell id="c5" value="data on disk (runs/, not in git)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;size=4;spacingTop=4;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1560" y="102" width="300" height="30" as="geometry"/></mxCell><mxCell id="c6" value="proposed · not built or not tried" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1560" y="138" width="300" height="30" as="geometry"/></mxCell><mxCell id="c7" value="1 · Simulate &amp; record" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="330" height="880" as="geometry"/></mxCell><mxCell id="c8" value="2 · Episodes &amp; labels" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="330" height="880" as="geometry"/></mxCell><mxCell id="c9" value="3 · Check &amp; look" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="300" height="880" as="geometry"/></mxCell><mxCell id="c10" value="4 · Train / fine-tune" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="440" height="880" as="geometry"/></mxCell><mxCell id="c11" value="5 · Drive &amp; evaluate" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="1500" y="160" width="440" height="880" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Simulator&lt;/b&gt; (drive/sim)&lt;br&gt;closed track · kinematic bicycle model&lt;br&gt;camera 320×240 · range sensor" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="290" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;pure-pursuit teacher&lt;/b&gt;&lt;br&gt;knows the map + exact pose&lt;br&gt;→ clean plan 16 × 0.1 s" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="290" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;steering disturbance&lt;/b&gt; (Ornstein–Uhlenbeck, σ 0.25)&lt;br&gt;added to the &lt;i&gt;applied&lt;/i&gt; steering only" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="290" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;./drive.sh collect&lt;/b&gt;&lt;br&gt;40 episodes × 30 s · samples at 10 Hz&lt;br&gt;--name sim2 --seed 100 · --show to watch" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="290" height="75" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;ROS 2&lt;/b&gt;: make ros-sim + ros-drive | ros-teleop&lt;br&gt;+ &lt;b&gt;make ros-record&lt;/b&gt; (Ctrl-C saves)&lt;br&gt;topics /drive/image · state · range · cmd" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="290" height="85" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;./drive.sh sim --record DIR&lt;/b&gt;&lt;br&gt;any policy, no labels" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="290" height="55" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;real car platform node&lt;/b&gt;&lt;br&gt;camera · encoder · ToF · ESC&lt;br&gt;publishes the same /drive/* topics" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="290" height="70" as="geometry"/></mxCell><mxCell id="c19" value="image, pose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c12" target="c13"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="intended steer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c13" target="c14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="applied = intended + noise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c14" target="c15"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="same topics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c18" target="c16"><mxGeometry x="0" relative="1" as="geomet