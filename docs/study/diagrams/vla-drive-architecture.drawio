e=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c58" target="c59"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c59" target="c60"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c60" target="c61"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c58" target="c62"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1935" y="342"/><mxPoint x="1935" y="770"/></Array></mxGeometry></mxCell><mxCell id="c71" value="export (not tried)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c47" target="c63"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="more, or more varied, drives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c60" target="c15"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1950" y="567"/><mxPoint x="1950" y="1070"/><mxPoint x="28" y="1070"/><mxPoint x="28" y="507"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page1" name="2 · Runtime: chunks → motor commands"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Runtime&lt;/b&gt; · how a slow policy's chunks become 50 Hz motor commands (drive/loop.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Platform (drive/platform.py) — one of" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="330" height="800" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;World&lt;/b&gt; (simulator)&lt;br&gt;t = simulated time" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="290" height="55" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;RosPlatform&lt;/b&gt; (ROS 2)&lt;br&gt;caches the latest /drive/* message" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="290" height="55" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;a real car&lt;/b&gt; behind the same topics" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="290" height="45" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;observe(task)&lt;/b&gt; → Observation&lt;br&gt;&amp;nbsp; t (camera time) · images · speed · steer&lt;br&gt;&amp;nbsp; task · pose (simulator only)&lt;br&gt;&lt;b&gt;range_m()&lt;/b&gt; → metres to the nearest thing ahead&lt;br&gt;&lt;b&gt;apply(action, dt)&lt;/b&gt; → motors" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="45" y="330" width="285" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ROS 2 topics&lt;/b&gt;&lt;br&gt;/drive/image  rgb8, 25 Hz&lt;br&gt;/drive/state  speed, steer position&lt;br&gt;/drive/range  metres&lt;br&gt;/drive/pose  simulator only&lt;br&gt;/drive/cmd  steer, throttle (−1..1)&lt;br&gt;&lt;br&gt;car side: brake if no /drive/cmd for 0.5 s" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=note;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="45" y="490" width="285" height="190" as="geometry"/></mxCell><mxCell id="c8" value="Inference worker — own thread, one inference at a time (≈ 5–10 Hz)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#eef6ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="660" height="330" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ThreadedWorker&lt;/b&gt; (car, --show)&lt;br&gt;real thread, real latency&lt;br&gt;&lt;b&gt;SimulatedWorker&lt;/b&gt;&lt;br&gt;fixed latency, repeatable" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="125" width="280" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Policy.infer(obs)&lt;/b&gt;&lt;br&gt;→ ActionChunk" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="125" width="300" height="55" as="geometry"/></mxCell><mxCell id="c11" value="pure-pursuit: map + pose · 50 × 1/30 s&lt;br&gt;lane-camera: road in the image · 15 × 1/30 s&lt;br&gt;cnn: ChunkNet · 16 × 0.1 s · ≈ 3 ms&lt;br&gt;&lt;b&gt;vla&lt;/b&gt;: BackendPolicy → LeRobotBackend&lt;br&gt;→ SmolVLA · 16 × 0.1 s · 125–190 ms on the laptop" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="300" height="115" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ActionChunk&lt;/b&gt;&lt;br&gt;actions N × [steer, throttle]&lt;br&gt;dt · t_obs (time of the observation)&lt;br&gt;actions[i] is meant for t_obs + i·dt" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="280" height="95" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;dashed=1;strokeColor=#999999;endArrow=none;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="169"/><mxPoint x="700" y="287"/></Array></mxGeometry></mxCell><mxCell id="c16" value="DriveLoop.step() — every 20 ms (50 Hz)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;fontFamily=Helvetica;fontSize=13;fillColor=#f7f7f8;strokeColor=#d0d0d6;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="660" height="440" as="geometry"/></mxCell><mxCell id="c17" value="① poll the worker: a new chunk? → executor.update" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="485" width="300" height="50" as="geometry"/></mxCell><mxCell id="c18" value="② worker idle? → submit(platform.observe())" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="③ command = executor.action(now)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="635" width="300" height="50" as="geometry"/></mxCell><mxCell id="c20" value="④ decision = safety.filter(command, speed,&lt;br&gt;range, plan age)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="710" width="300" height="55" as="geometry"/></mxCell><mxCell id="c21" value="⑤ platform.apply(decision.action, 0.02 s)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="790" width="300" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ChunkExecutor&lt;/b&gt;&lt;br&gt;reads the chunk at now − t_obs:&lt;br&gt;skips the actions meant for the time&lt;br&gt;spent computing (latency compensation)&lt;br&gt;fades a new chunk in over 0.1 s&lt;br&gt;None once the chunk has run out&lt;br&gt;plan age = now − t_obs ∈ [L, 2L)" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="730" y="485" width="290" height="160" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;SafetySupervisor&lt;/b&gt; — the last word&lt;br&gt;estop → brake&lt;br&gt;no plan, or age &amp;gt; 0.6 s → brake (stale)&lt;br&gt;NaN → brake&lt;br&gt;clip to ±1 · steering rate ≤ 8 /s&lt;br&gt;speed &amp;gt; 2 m/s → cut throttle&lt;br&gt;range sensor → slow, brake, stop 0.30 m short" style="whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="730" y="665" width="290" height="175" as="geometry"/></mxCell><mxCell id="c24" value="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=